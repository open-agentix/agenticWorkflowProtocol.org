---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<div class="awp-title">
  <Default><slot /></Default>
  <span class="awp-version" title="API version v1alpha1, draft status">v1alpha1 <span class="draft">(draft)</span></span>
</div>

<style>
  .awp-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }
  .awp-version {
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
    background: var(--sl-color-bg-sidebar);
  }
  @media (max-width: 22rem) {
    .draft {
      display: none;
    }
  }
</style>
