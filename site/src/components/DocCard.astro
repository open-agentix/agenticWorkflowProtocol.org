---
// Documentation card with an inline SVG icon (no external assets).
interface Props { title: string; href: string; icon?: string; }
const { title, href, icon = 'book' } = Astro.props;
const icons: Record<string, string> = {
  rocket: 'M5 15c-1.5 1.2-2 4-2 6 2 0 4.8-.5 6-2M14 4c3-1.5 6-1.5 7-1 .5 1 .5 4-1 7l-7 7-6-6zM9 11l-4-1 2-3 4 0M13 15l1 4 3-2 0-4',
  book: 'M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 19V5M9 7h6',
  layers: 'M12 3l9 5-9 5-9-5zM3 13l9 5 9-5M3 17l9 5 9-5',
  shield: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4',
  lock: 'M6 11h12v9H6zM8 11V8a4 4 0 0 1 8 0v3',
  code: 'M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16',
  check: 'M4 12l5 5L20 6',
  users: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20a6 6 0 0 1 12 0M16 5a3 3 0 0 1 0 6M18 14a6 6 0 0 1 3 6',
  branch: 'M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 9c0 6-12 3-12 6',
};
---

<a class="doc-card" href={href}>
  <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={icons[icon] ?? icons.book} /></svg>
  </span>
  <span class="body">
    <span class="title">{title}</span>
    <span class="text"><slot /></span>
  </span>
</a>

<style>
  .doc-card {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    min-height: 3.5rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    text-decoration: none;
    color: var(--sl-color-white);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .doc-card:hover {
    border-color: var(--sl-color-accent);
    box-shadow: 0 1px 8px rgb(0 0 0 / 0.07);
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.6rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
  }
  .body {
    min-width: 0;
    display: block;
  }
  .title {
    display: block;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
  }
  .text {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--sl-color-gray-2);
  }
</style>
